{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Experience",
  "type": "object",
  "required": ["experience_id", "company", "role", "period", "project", "result"],
  "properties": {
    "experience_id": { "type": "string" },
    "company": { "type": "string" },
    "role": { "type": "string" },
    "period": {
      "type": "object",
      "required": ["start"],
      "properties": {
        "start": { "type": "string" },
        "end": { "type": "string" }
      },
      "additionalProperties": false
    },
    "project": { "type": "string" },
    "result": { "type": "string" },
    "actions": {
      "type": "array",
      "items": { "type": "string" }
    },
    "metrics": { "type": "object" }
  },
  "additionalProperties": false
}
