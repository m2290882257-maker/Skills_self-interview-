{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GenerateInterviewerFollowupsOutput",
  "type": "object",
  "required": ["followups"],
  "properties": {
    "followups": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "items": {
        "type": "object",
        "required": ["question", "intent", "pressure_level", "expected_signal"],
        "properties": {
          "question": { "type": "string", "minLength": 1 },
          "intent": { "type": "string", "minLength": 1 },
          "pressure_level": {
            "type": "string",
            "enum": ["low", "medium", "high"]
          },
          "expected_signal": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
