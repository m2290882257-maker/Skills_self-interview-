{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "InterviewQuestion",
  "type": "object",
  "required": ["question_id", "text", "tags", "difficulty", "confirmed"],
  "properties": {
    "question_id": { "type": "string" },
    "text": { "type": "string" },
    "tags": {
      "type": "array",
      "items": { "type": "string" }
    },
    "difficulty": {
      "type": "string",
      "enum": ["easy", "medium", "hard"]
    },
    "followup_focus": {
      "type": "array",
      "items": { "type": "string" }
    },
    "confirmed": { "type": "boolean", "default": false }
  },
  "additionalProperties": false
}
